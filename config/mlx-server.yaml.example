server:
  host: "0.0.0.0"            # required so the dockerized daemon can reach it via host.docker.internal
  port: 18000                # 8000 is commonly taken by other dev stacks; pick anything free
  log_level: INFO

# mlx-server v1.8.1 has a known on-demand bug: the idle-unload timer is
# scheduled when the FIRST request after a load completes, and subsequent
# requests on the loaded model don't reset it (their resolve path
# short-circuits via get_handler before ensure_on_demand_loaded). So a
# batch of streaming requests within the idle window can trigger an
# unload mid-stream of the LAST request.
#
# Mitigation here: pick idle_timeouts long enough that any realistic batch
# fits inside a single window. The daemon also enforces a per-chunk
# stream timeout (config.llm.stream_chunk_timeout_seconds) as
# defence-in-depth so a hung backend stream eventually fails the job
# instead of locking the queue forever.
models:
  # LLM: Qwen3-VL 8B Instruct (4-bit) — ~5.8 GB weights. context_length is
  # capped at 65536 (not the model's full window) on purpose: a larger KV
  # cache doesn't fit comfortably in unified memory alongside the weights.
  # Not a thinking model — no reasoning_effort knob needed.
  #
  # model_type MUST be "multimodal", not "lm": mlx-openai-server dispatches
  # "lm" to MLXLMHandler (mlx_lm, text-only) and only "multimodal" to
  # MLXVLMHandler (mlx_vlm, which accepts image_url content) — confirmed by
  # reading app/server.py::create_handler_from_config and
  # app/config.py::VALID_MODEL_TYPES in the mlx-openai-server 1.8.1 source
  # (github.com/cubist38/mlx-openai-server). "lm" would silently break PDF
  # vision OCR and video-frame QA, the reason this project uses a VL model
  # at all.
  #
  # Prefer Gemma 4 E4B instead? Swap in mlx-community/gemma-4-E4B-it-qat-4bit,
  # served_model_name gemma4, context_length 131072 (model_type stays
  # "multimodal" — Gemma 4 E4B is vision-capable too), and set
  # config/tldr.yaml's llm.reasoning_effort to "low" (Gemma 4 is a thinking
  # model).
  - model_path: mlx-community/Qwen3-VL-8B-Instruct-4bit
    model_type: multimodal
    served_model_name: qwen3-vl
    context_length: 65536
    on_demand: true
    on_demand_idle_timeout: 1800   # 30 min — frees ~5.8 GB after a batch finishes
    kv_bits: 4
    kv_group_size: 64

  - model_path: mlx-community/whisper-large-v3-turbo
    model_type: whisper
    served_model_name: whisper
    on_demand: true
    on_demand_idle_timeout: 3600   # 60 min — covers single long transcription streams
