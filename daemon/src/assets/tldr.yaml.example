# Daemon configuration. Loaded at startup by daemon/src/config.py.
# Environment variables prefixed with TLDR__ override individual fields,
# e.g. TLDR__OUTPUT__LANGUAGE=English
#
# llm.base_url and whisper.base_url are INDEPENDENT — they can point at the
# same server (e.g. mlx-openai-server serves both) or different ones
# (e.g. LM Studio for LLM + whisper.cpp server for Whisper).
#
# Whisper is only needed as a last resort for YouTube videos that have no
# official transcripts and no auto-generated captions. If you skip it those
# videos will error at the transcription step rather than falling back.
#
# llm.base_url / whisper.base_url can point at a LOCAL server (the default,
# examples right below) or a CLOUD one (examples further down, after
# "LLM only") — same daemon, same pipeline either way.

# ---------------------------------------------------------------------------
# API key storage — applies independently to llm.* and whisper.*, in this
# priority order (first match wins):
#   1. Environment variable TLDR__LLM__API_KEY / TLDR__WHISPER__API_KEY —
#      overrides everything below. Convenient for Docker/foreground runs
#      and CI, or an EnvironmentFile on the systemd unit.
#   2. api_key_keychain (keychain service name) + api_key_keychain_account
#      (account name) — macOS Keychain / Linux Secret Service. Recommended:
#      `keyring` is a base dependency (no extra install step), and it's the
#      default the options page / `PATCH /config` pick when a usable
#      backend is available. The daemon writes the entry itself, so it's
#      automatically in its own trusted-app ACL and reads it back with zero
#      prompts afterwards — including after `uv tool install --force`.
#      Linux needs a Secret Service (GNOME Keyring / KWallet) running in
#      the session; the options page falls back to File automatically when
#      none is found.
#   3. api_key_file — path to a file containing just the key (`~` expands),
#      permissions must be 0600. The right choice for Docker installs (no
#      macOS Keychain, no Secret Service in the container) or if you just
#      prefer a file.
#   4. api_key inline below — fine for local backends that ignore the value
#      (ollama, dummy, lm-studio, ...); avoid it for real cloud keys since
#      this file sits in plain text (tldr.yaml itself is created 0600, but
#      that's the only protection an inline key gets).
#
# Escape hatches, mostly relevant for cloud/reasoning backends — defaults
# are usually right, the daemon auto-detects the backend's dialect from its
# first response and retries once on an HTTP 400 (this is what makes gpt-5
# and the o-series work with no extra config):
#   token_param: auto                # auto | max_tokens | max_completion_tokens
#   send_temperature: true           # default: auto-detected; some reasoning models reject temperature
#   reasoning_headroom_tokens: 4000  # reserve output budget for hidden reasoning (gpt-5/o-series, etc.)
#   max_output_tokens: 8000          # optional hard cap on visible output tokens
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backend: Ollama (any OS, easiest setup) — default
# Install: https://ollama.com/download
# Then: ollama pull gemma4:e4b && ollama serve
#
# IMPORTANT — Ollama uses a tiny context window by default (often 2048).
# Gemma 4 E4B supports 128K. Expand it once with a Modelfile:
#
#   printf 'FROM gemma4:e4b\nPARAMETER num_ctx 131072\n' > Modelfile
#   ollama create gemma4:e4b-128k -f Modelfile
#
# Then set model: gemma4:e4b-128k below and context_length: 131072.
# Without this, long pages and videos will be silently truncated.
# ---------------------------------------------------------------------------
llm:
  base_url: http://host.docker.internal:11434/v1
  api_key: ollama
  model: gemma4:e4b-128k                           # see note above; use gemma4:e4b if you skip the Modelfile step
  context_length: 131072
  single_pass_token_limit: 80000                   # above this → map-reduce (~60% of context_length)
  # Cap on simultaneous LLM calls. 1 is safe on most local setups;
  # bump to 2-3 on a beefy GPU server or a hosted backend.
  max_concurrent_calls: 1

whisper:
  # Whisper is only used as a last-resort fallback for YouTube videos with no
  # captions. Most videos have auto-generated captions — you can leave this
  # block pointing at a non-existent server and the daemon will skip Whisper
  # gracefully. To enable it, pick a backend:
  #
  #   macOS Apple Silicon:  task install:mlx  (port 18000)
  #   Any OS (Docker):      docker run -p 8000:8000 fedirz/faster-whisper-server
  #   Any OS (brew):        brew install whisper-cpp && whisper-server -m ggml-large-v3.bin
  base_url: http://host.docker.internal:18000/v1
  api_key: dummy
  model: whisper                                   # served_model_name in ~/.mlx-server/config.yaml

# ---------------------------------------------------------------------------
# Backend: LM Studio (LLM) + mlx-openai-server (Whisper)
# LM Studio: https://lmstudio.ai — GUI app, enable local server on port 1234.
# Load any GGUF model (e.g. lmstudio-community/gemma-4-E4B-it-GGUF Q4_K_M).
#
# IMPORTANT — LM Studio defaults to a small context window. After loading the
# model, open its settings and set Context Length to 131072 — otherwise long
# pages and videos will be silently truncated.
# Check the active context: lms ps  (shows CONTEXT column for the loaded model)
#
# reasoning_effort controls Gemma 4 thinking; the right value depends on the
# backend (the daemon adds it to every chat call):
#   mlx-openai-server / mlx_vlm: "low" — thinking stays hidden in
#     reasoning_content (our code ignores it), content arrives clean.
#   LocalAI / llama.cpp (gallery GGUF, jinja template): thinking is ADAPTIVE —
#     it fires nondeterministically on "hard" prompts, delaying or (with a
#     small max_tokens) entirely consuming the answer. "low" does NOT fully
#     suppress it (measured 1/6 runs); use "none" (0/6, faster median).
#     chat_template_kwargs {enable_thinking: false} is unreliable — don't.
#   Real OpenAI API: "none" is rejected — remove the field entirely.
# Note: LocalAI responses carry "reasoning": null in message; harmless for
# the bundled client, but beware strict response-schema validation.
# ---------------------------------------------------------------------------
# llm:
#   base_url: http://host.docker.internal:1234/v1
#   api_key: lm-studio                             # LM Studio doesn't check it
#   model: google/gemma-4-e4b                      # model ID shown by LM Studio API
#   context_length: 131072                         # match `lms ps` CONTEXT column
#   single_pass_token_limit: 80000                 # ~60% of context_length
#   max_concurrent_calls: 1
#   reasoning_effort: "low"                        # keep Gemma 4 thinking hidden; omit for non-thinking models
#
# whisper:
#   base_url: http://host.docker.internal:18000/v1
#   api_key: dummy
#   model: whisper

# ---------------------------------------------------------------------------
# Backend: mlx-openai-server — Apple Silicon, LLM + Whisper in one server
# Install with: task install:mlx  (sets up ~/.mlx-server/config.yaml)
# Fastest local option; uses Metal GPU natively.
#
# NOTE: mlx-openai-server support for Gemma 4 is pending a stable release.
# If it doesn't load, edit ~/.mlx-server/config.yaml and switch to
# mlx-community/gemma-3-12b-it-4bit (served_model_name: gemma3) until fixed.
# ---------------------------------------------------------------------------
# llm:
#   base_url: http://host.docker.internal:18000/v1
#   api_key: dummy
#   model: gemma4                                  # served_model_name in ~/.mlx-server/config.yaml
#   context_length: 131072                         # must match context_length in ~/.mlx-server/config.yaml
#   single_pass_token_limit: 80000                 # ~60% of context_length
#   max_concurrent_calls: 1
#
# whisper:
#   base_url: http://host.docker.internal:18000/v1
#   api_key: dummy
#   model: whisper

# ---------------------------------------------------------------------------
# Backend: llama-server (LLM) + whisper-server (Whisper) — cross-platform
# `brew install llama.cpp whisper-cpp`
# llama-server: llama-server -m model.gguf --port 8080 -ngl 99 -c 131072
# whisper-server: whisper-server -m ggml-large-v3.bin --port 8081
#
# The -c flag sets the context window. context_length here must match -c.
# ---------------------------------------------------------------------------
# llm:
#   base_url: http://host.docker.internal:8080/v1
#   api_key: dummy
#   model: ""                                      # llama-server ignores model name
#   context_length: 131072                         # must match -c flag passed to llama-server
#   single_pass_token_limit: 80000                 # ~60% of context_length
#   max_concurrent_calls: 1
#
# whisper:
#   base_url: http://host.docker.internal:8081/v1
#   api_key: dummy
#   model: whisper-1                               # whisper-server ignores model name

# ---------------------------------------------------------------------------
# Backend: LLM only — no Whisper fallback
# Use any LLM server above. Omit the whisper block or point it at a
# non-existent URL — YouTube jobs that reach the Whisper step will error.
# Web-page jobs are unaffected (no Whisper needed).
# ---------------------------------------------------------------------------
# llm:
#   base_url: http://host.docker.internal:11434/v1
#   api_key: ollama
#   model: gemma4:e4b
#   context_length: 131072
#   single_pass_token_limit: 80000
#   max_concurrent_calls: 1

# ---------------------------------------------------------------------------
# Backend: OpenAI (cloud)
# https://platform.openai.com/docs/api-reference
#
# Prefer api_key_file (or api_key_keychain) over inline api_key for a real
# key — see "API key storage" above. context_length/single_pass_token_limit
# should match the model you pick, not the local Gemma defaults above:
# gpt-5's context window is much bigger than 128K. reasoning_headroom_tokens
# covers gpt-5/o-series' hidden reasoning tokens; token_param and
# send_temperature are auto-detected, no need to set them here.
# ---------------------------------------------------------------------------
# llm:
#   base_url: https://api.openai.com/v1
#   api_key_file: ~/.config/tldr/openai.key          # or: api_key_keychain: tldr-daemon / api_key_keychain_account: openai
#   model: gpt-5                                      # or gpt-5-mini, o4-mini, ...
#   context_length: 400000                            # check the model's actual window
#   single_pass_token_limit: 240000                   # ~60% of context_length
#   max_concurrent_calls: 3                           # hosted backends tolerate more parallelism than a laptop GPU
#
# whisper:
#   base_url: https://api.openai.com/v1
#   api_key_file: ~/.config/tldr/openai.key          # or: api_key_keychain: tldr-daemon-whisper / api_key_keychain_account: openai
#   model: whisper-1                                  # pay-per-minute; local Whisper is free

# ---------------------------------------------------------------------------
# Backend: Anthropic (cloud) — via its OpenAI-compatible endpoint
# https://docs.anthropic.com/en/api/openai-sdk
# No Whisper here — pair with a local Whisper backend above, or OpenAI's.
# ---------------------------------------------------------------------------
# llm:
#   base_url: https://api.anthropic.com/v1
#   api_key_file: ~/.config/tldr/anthropic.key
#   model: claude-sonnet-4-5
#   context_length: 200000
#   single_pass_token_limit: 120000
#   max_concurrent_calls: 3

# ---------------------------------------------------------------------------
# Backend: Google Gemini (cloud) — via its OpenAI-compatible endpoint
# https://ai.google.dev/gemini-api/docs/openai
# ---------------------------------------------------------------------------
# llm:
#   base_url: https://generativelanguage.googleapis.com/v1beta/openai/
#   api_key_file: ~/.config/tldr/gemini.key
#   model: gemini-2.5-flash
#   context_length: 1000000
#   single_pass_token_limit: 600000
#   max_concurrent_calls: 3

# ---------------------------------------------------------------------------
# Backend: OpenRouter (cloud) — one key, routes to almost any hosted model
# https://openrouter.ai/docs/quickstart
# ---------------------------------------------------------------------------
# llm:
#   base_url: https://openrouter.ai/api/v1
#   api_key_file: ~/.config/tldr/openrouter.key
#   model: openai/gpt-5                               # provider/model — pick anything OpenRouter hosts
#   context_length: 400000                            # match whichever model you route to
#   single_pass_token_limit: 240000
#   max_concurrent_calls: 3

# ---------------------------------------------------------------------------
# Output language. Use an ISO 639-1 code: en, ru, de, fr, es, it, pt, ja, …
# (the daemon expands it to the full name when prompting the LLM, which
# helps smaller models stick to the language). Anything else is passed
# through verbatim, so you can also write "Brazilian Portuguese" if needed.
# ---------------------------------------------------------------------------
output:
  language: en

youtube:
  fast_path_max_attempts: 4
  fast_path_backoff_seconds: [1, 4, 16, 60]
  segment_window_seconds: 30        # aggregate transcript segments into [MM:SS]-marked windows
  audio_format: opus
  audio_bitrate_max: 64
  ytdlp_sleep_interval: [3, 8]      # min, max seconds between yt-dlp requests
  # When the youtube-transcript-api fast path fails, yt-dlp tries to grab
  # auto-generated captions before falling back to Whisper. The original
  # video language is always tried first; this list adds further preferences.
  subtitle_lang_preferences: ["en", "ru"]

storage:
  data_dir: /data                   # mounted volume in the container
  db_filename: tldr.db
  retention_days: 365               # daemon deletes jobs older than this; 0 disables

# ---------------------------------------------------------------------------
# Q&A (follow-up questions in the side panel).
#
# web_search: true (default) — when the processed material doesn't fully
# answer your question, the daemon runs a DuckDuckGo text search built from
# your question, then fetches and cleans a handful of the resulting pages,
# to enrich the answer. This means a search-engine query derived from your
# question, and requests to whatever pages DuckDuckGo returns, go out over
# the internet — separate from your configured LLM backend and from the
# original page/video fetch. The side panel shows a "searching" stage while
# this happens, so it's never silent (see PRIVACY.md's "Web search for Q&A").
#
# web_search: false — disables this entirely: no DuckDuckGo query, no page
# fetch, ever. The daemon answers only from the material you processed and
# the model's own training knowledge, and is told to say plainly when
# something isn't covered rather than guess.
# ---------------------------------------------------------------------------
qa:
  web_search: true

workers:
  # Sleep this long between consecutive background jobs (Whisper queue and
  # streaming summaries) to let the CPU/GPU cool down. 0 = back-to-back.
  cooldown_seconds: 0

logging:
  level: INFO

# ---------------------------------------------------------------------------
# Cloud providers — where the URLs and keys come from
# ---------------------------------------------------------------------------
# Text (llm.base_url) + the page that issues the key:
#   OpenAI         https://api.openai.com/v1                                platform.openai.com/api-keys
#   Anthropic      https://api.anthropic.com/v1/                            platform.claude.com/settings/keys
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai/ aistudio.google.com/apikey
#   OpenRouter     https://openrouter.ai/api/v1                             openrouter.ai/keys
#   Groq           https://api.groq.com/openai/v1                           console.groq.com/keys
#   DeepSeek       https://api.deepseek.com                                 platform.deepseek.com/api_keys
#   Mistral        https://api.mistral.ai/v1                                console.mistral.ai
#   Together AI    https://api.together.ai/v1                               api.together.ai settings -> API keys
#   Fireworks AI   https://api.fireworks.ai/inference/v1                    app.fireworks.ai -> API keys
#   xAI (Grok)     https://api.x.ai/v1                                      console.x.ai -> API keys
# The trailing slash on the Gemini URL is required. Azure OpenAI needs its
# newer v1 endpoint (https://{resource}.openai.azure.com/openai/v1/) and
# takes the DEPLOYMENT name in `model`.
#
# Audio (whisper.base_url) — far fewer providers have one at all. We need
# POST {base_url}/audio/transcriptions to return verbose_json WITH segments,
# otherwise transcripts carry no timecodes:
#   OpenAI         model: whisper-1                 (gpt-4o-transcribe has no segments!)
#   Groq           model: whisper-large-v3-turbo    (or whisper-large-v3)
#   Together AI    model: openai/whisper-large-v3
#   OpenRouter     only while it routes to one of the three above
# NO transcription endpoint: Anthropic, Google Gemini, DeepSeek. Fireworks
# deprecated audio in June 2026; xAI has STT but at /v1/stt, which our
# OpenAI-compatible client cannot reach. Mistral and Azure are untested.
# Cloud transcription is billed per minute of audio; local Whisper is free.
# Checked 2026-07-31 — providers move these, so verify if something 404s.
